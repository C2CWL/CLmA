<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar / notification icon: the CLmA mark (open arc + node + centre dot), drawn as a
     flat white silhouette so the system can tint it. Same geometry as ic_clma_mark.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <group
        android:pivotX="60"
        android:pivotY="60"
        android:scaleX="0.85"
        android:scaleY="0.85">
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:pathData="M89.45,54.28 A30,30 0 1,1 65.72,30.55" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M70.21,38.79 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M54,60 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 Z" />
    </group>
</vector>
